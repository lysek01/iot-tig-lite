#!/bin/bash
# Prints the Telegraf configuration built from the environment variables.
# Not used when you mount your own /etc/telegraf/telegraf.conf.

set -euo pipefail

# TOML basic string
q() { local s=${1//\\/\\\\}; s=${s//\"/\\\"}; printf '"%s"' "$s"; }

# MQTT_TOPICS "a/#, b/c" -> ["a/#", "b/c"]
topics=""
IFS=',' read -ra list <<<"$MQTT_TOPICS"
for t in "${list[@]}"; do
  t="${t#"${t%%[![:space:]]*}"}"; t="${t%"${t##*[![:space:]]}"}"   # trim
  [ -n "$t" ] && topics+="${topics:+, }$(q "$t")"
done

cat <<EOF
# Generated by iot-tig-lite from environment variables – do not edit.
# To use your own configuration, mount it as /etc/telegraf/telegraf.conf.

[agent]
  interval = "10s"
  round_interval = true
  flush_interval = "5s"
  metric_buffer_limit = 10000
  omit_hostname = true
  skip_processors_after_aggregators = true

[[outputs.influxdb]]
  urls = ["http://127.0.0.1:8086"]
  database = $(q "$INFLUXDB_DB")
  username = $(q "$INFLUXDB_USER")
  password = $(q "$INFLUXDB_USER_PASSWORD")
  skip_database_creation = true
  timeout = "10s"

[[inputs.mqtt_consumer]]
  servers = [$(q "$MQTT_SERVER")]
  topics = [$topics]
  qos = 0
  connection_timeout = "30s"
  startup_error_behavior = "retry"
EOF

if [ -n "$MQTT_USERNAME" ]; then
  echo "  username = $(q "$MQTT_USERNAME")"
  echo "  password = $(q "$MQTT_PASSWORD")"
fi

# how incoming messages are parsed (same for MQTT and HTTP)
payload_format() {
  if [ "$MQTT_FORMAT" = "influx" ]; then
    echo '  data_format = "influx"'
  else
    echo '  name_override = "mqtt"'
    echo '  data_format = "value"'
    echo '  data_type = "string"'
  fi
}
payload_format

case "${HTTP_ENABLED,,}" in
  true|yes|1|on)
    cat <<EOF

# HTTP input: POST/PUT to http://<host>:8080/data, topic in the "Topic" header
[[inputs.http_listener_v2]]
  service_address = ":8080"
  paths = ["/data"]
  methods = ["POST", "PUT"]
  http_header_tags = {"Topic" = "topic"}
  max_body_size = "1MB"
EOF
    if [ -n "${HTTP_USERNAME:-}" ]; then
      echo "  basic_username = $(q "$HTTP_USERNAME")"
      echo "  basic_password = $(q "${HTTP_PASSWORD:-}")"
    fi
    payload_format
    ;;
esac

if [ "$MQTT_FORMAT" != "influx" ]; then
  cat <<EOF

# Turns the raw payload into fields (number, true/false, JSON, text).
[[processors.starlark]]
  order = 1
  namepass = ["mqtt"]
  script = "/usr/share/iot-tig-lite/mqtt-payload.star"
  [processors.starlark.constants]
    mode = $(q "$MQTT_FORMAT")
    time_field = $(q "${MQTT_TIME_FIELD:-}")
    tz = $(q "${TZ:-UTC}")
EOF
fi

# MQTT_TOPIC_TAGS: levels of the "topic" tag become extra tags
if [ -n "${MQTT_TOPIC_TAGS//[[:space:]]/}" ]; then
  cat <<EOF

[[processors.starlark]]
  order = 2
  script = "/usr/share/iot-tig-lite/topic-tags.star"
  [processors.starlark.constants]
    patterns = $(q "${MQTT_TOPIC_TAGS//[[:space:]]/}")
EOF
fi

case "${SYSTEM_METRICS,,}" in
  true|yes|1|on)
    cat <<'EOF'

# System metrics of the host (used by the "System" dashboard)
[[inputs.cpu]]
  interval = "30s"
  percpu = false
  totalcpu = true
  collect_cpu_time = false
  report_active = true

[[inputs.mem]]
  interval = "30s"

[[inputs.disk]]
  interval = "30s"
  mount_points = ["/"]

[[inputs.system]]
  interval = "30s"

[[inputs.temp]]
  interval = "30s"

[[inputs.filecount]]
  interval = "60s"
  name_override = "influxdb_size"
  directories = ["/var/lib/influxdb"]
  recursive = true
EOF
    ;;
esac
