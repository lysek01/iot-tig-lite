# =====================================================================
#  iot-tig-lite - configuration
#  Copy this file to ".env", edit the values, then run:
#      docker compose up -d
#  After any change, run "docker compose up -d" again to apply it.
# =====================================================================


# ---------------------------------------------------------------------
#  MQTT - where Telegraf reads the data from
# ---------------------------------------------------------------------

# Broker address.
#   internal              = use the MQTT broker built into this container
#                           (devices publish to <this-host-ip>:1883)
#   tcp://<host>:1883     = external broker, plain connection
#   ssl://<host>:8883     = external broker, TLS connection
MQTT_BROKER=internal

# Credentials Telegraf uses to log in to the broker.
# Leave empty for anonymous access.
MQTT_USERNAME=
MQTT_PASSWORD=

# Topics to subscribe to, comma separated. MQTT wildcards are allowed:
#   +  matches exactly one level    (home/+/temperature)
#   #  matches all remaining levels (home/#)
# Examples:  #   |   sensors/#   |   room1/temp,room2/temp
MQTT_TOPICS=#

# Payload format of incoming messages.
#   auto    = detect per message: number, true/false, JSON or text
#   value   = single value per message        e.g.  23.4
#   json    = JSON object, one field per key  e.g.  {"temp":23.4,"hum":41}
#   influx  = InfluxDB line protocol          e.g.  env,room=lab temp=23.4
MQTT_FORMAT=auto

# Data are stored as:  measurement "mqtt", tag "topic" = full topic name,
#                      field "value" (or one field per JSON key).


# ---------------------------------------------------------------------
#  InfluxDB 1.8 - time-series database
#  (same variable names as the official influxdb:1.8 image)
#  All values below are applied on every start, existing data are kept.
# ---------------------------------------------------------------------

# Database that stores the MQTT data.
INFLUXDB_DB=iot

# User with full privileges on the database above.
# Grafana and Telegraf use this account automatically.
INFLUXDB_USER=iot
INFLUXDB_USER_PASSWORD=iot

# Server administrator (manages all databases and users).
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=admin

# How long to keep data. Older data are deleted automatically,
# which protects small SD cards from filling up.
#   Units: h (hours), d (days), w (weeks), or INF to keep forever.
#   Examples:  12h  |  7d  |  30d  |  52w  |  INF
INFLUXDB_RETENTION=30d


# ---------------------------------------------------------------------
#  Grafana - web dashboards on http://<this-host-ip>:3000
#  (any official GF_* variable can be added here)
# ---------------------------------------------------------------------

# Administrator login. Only applied on the first start -
# later, change the password in the Grafana web UI.
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# Allow viewing dashboards without logging in (e.g. wall displays).
GF_AUTH_ANONYMOUS_ENABLED=false


# ---------------------------------------------------------------------
#  Other
# ---------------------------------------------------------------------

# Collect CPU, memory, temperature and disk usage of this device
# (shown in the "System" dashboard).
SYSTEM_METRICS=true

# Time zone used in logs.
TZ=Europe/Prague
